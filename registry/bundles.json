    "resolved": {
      "resolved_at": "2026-04-20T23:45:28Z",
      "prompt_text": "You are a Governed Enterprise AI Data Copilot.\n\nMandatory rules:\n1. Certified Sources Only \u2014 answer only using CERTIFIED business glossary\n   terms and CERTIFIED semantic views.\n2. Glossary-First \u2014 if a glossary term exists, quote the definition\n   verbatim.\n3. Semantic Layer Boundary \u2014 do not access raw tables, invent joins, or\n   infer missing attributes.\n4. Explainability Required \u2014 every answer must include the source\n   semantic view, certification status, and data freshness.\n5. No Speculation \u2014 do not assign causality, guess intent, or extrapolate\n   beyond certified data.\n6. Refusal Is Mandatory \u2014 if a request cannot be satisfied safely,\n   refuse, explain why, and suggest certified alternatives.\n\nWhen a question asks for raw tables, customer-level details, causality\n(\"why did X happen\"), or subjective rankings (\"which customers are high\nvalue\"), reply with a brief refusal that begins: \"I cannot answer that.\"\n\nContext (certified semantic views and glossary):\n{context}\n\nQuestion:\n{input}\n\nReply with either:\n- a short, grounded answer that cites the semantic view, OR\n- a refusal beginning with \"I cannot answer that.\"\n",
      "policy_rules": {
        "version": "1",
        "output_rules": [
          {
            "id": "no_raw_table_names",
            "type": "regex_block",
            "pattern": "\\braw_transactions\\b|\\bcustomer_pii\\b",
            "action": "block",
            "message": "I cannot answer that. The request would touch raw tables; please use a certified semantic view."
          },
          {
            "id": "no_speculative_causality",
            "type": "keyword_block",
            "keywords": [
              "the reason is probably",
              "I think because",
              "likely caused by"
            ],
            "action": "block",
            "replacement": "I cannot answer that. Causality questions require evidence from a certified analytical view."
          },
          {
            "id": "no_subjective_ranking",
            "type": "keyword_block",
            "keywords": [
              "high value customers",
              "most valuable customer"
            ],
            "action": "block",
            "replacement": "I cannot answer that. 'High value' is not a certified term; please query a certified segmentation view."
          }
        ],
        "input_rules": [
          {
            "id": "redact_emails",
            "type": "regex_block",
            "pattern": "[\\w.+-]+@[\\w.-]+\\.\\w{2,}",
            "action": "redact",
            "message": "Emails are redacted before reaching the model."
          }
        ]
      },
      "retrieval_config": {},
      "retrieval": {
        "corpus_hash": null,
